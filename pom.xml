<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ste.vnc</groupId>
    <artifactId>mini-rfb</artifactId>
    <version>0.0.0</version>
    <packaging>jar</packaging>

    <name>Mini RFB</name>
    <description>Client-side implementation of minimal RFB/VNC protocol (RFC 6143)</description>
    <url>https://github.com/stefanofornari/mini-rfb</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>stefanofornari</id>
            <name>Stefano Fornari</name>
            <email>stefano.fornari@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/stefanofornari/mini-rfb.git</connection>
        <developerConnection>scm:git:git@github.com:stefanofornari/mini-rfb.git</developerConnection>
        <url>https://github.com/stefanofornari/mini-rfb</url>
        <tag>mini-rfb-0.0.0</tag>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <javafx.version>21.0.12</javafx.version>
        <maven.surefire.version>3.5.6</maven.surefire.version>
        <maven.shade.version>3.6.2</maven.shade.version>
        <maven.source.version>3.4.0</maven.source.version>
        <maven.javadoc.version>3.12.0</maven.javadoc.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <nexus.staging.version>1.7.0</nexus.staging.version>
        <maven.release.version>3.3.1</maven.release.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- io.github.seujorgenochurras:image-to-ascii is on Maven Central proper
             (not JitPack), so this is a normal, reproducible dependency. -->
        <dependency>
            <groupId>io.github.seujorgenochurras</groupId>
            <artifactId>image-to-ascii</artifactId>
            <version>0.0.5</version>
        </dependency>
        <!--
            JavaFX artifacts are platform-specific from JavaFX 11 onwards.
            No explicit classifier here - the os-maven-plugin extension below
            plus javafx-maven-plugin handle platform resolution themselves;
            pinning ${os.detected.classifier} directly on this dependency
            conflicted with that rather than helping.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven.gpg.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${maven.release.version}</version>
                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <useReleaseProfile>false</useReleaseProfile>
                    <releaseProfiles>release</releaseProfiles>
                    <goals>deploy</goals>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <version>${nexus.staging.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <serverId>ossrh</serverId>
                    <nexusUrl>https://oss.sonatype.org/</nexusUrl>
                    <autoReleaseAfterClose>true</autoReleaseAfterClose>
                </configuration>
            </plugin>
            <!--
                Builds target/mini-rfb-<version>-all.jar: an executable
                fat jar bundling this project's classes plus all runtime
                dependencies (image-to-ascii and whatever it pulls in
                transitively — junit/assertj are test-scoped and excluded
                automatically). JavaFX is deliberately excluded here too: its
                jars are platform-specific (see the classifier note above), so
                bundling one would tie this fat jar to whichever OS built it.
                The JavaFX demo is meant to be run via `mvn javafx:run`
                instead (see the javafx-maven-plugin below) - this fat jar's
                entry point stays the console-only ASCII demo, which has no
                platform-specific dependencies.
                Run with: java -jar target/mini-rfb-0.1.0-all.jar <host> [port] [columns] [engine]
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.openjfx:*</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ste.vnc.demo.AsciiVNCDemo</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Enables `mvn javafx:run` to launch VNCViewerDemoApp directly,
                with the correct JavaFX module-path wiring handled for you.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>ste.vnc.demo.javafx.VNCViewerDemoApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <snapshotRepository>
            <id>central.sonatype.com</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>central.sonatype.com</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>
</project>
